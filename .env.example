# Copiez en .env et renseignez tous les secrets avant le démarrage.
# ATTENTION : ce fichier contient des identifiants réels, ne le versionnez pas.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL — Render (External/Internal Database URL)
# Si DATABASE_URL est renseignée, les variables DB_* ci-dessous sont ignorées.
DATABASE_URL=postgresql://mobile_shop_u1u9_user:C2euf6MiDWMg4l6P5v8T2pyBH3l9xVLf@dpg-dbflfrt9fdbs739ds3jg-a/mobile_shop_u1u9

# PostgreSQL — repli local (si DATABASE_URL est vide)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=PgAdmin
DB_DATABASE=sre_paiement
# DB_SSL=true est appliqué automatiquement quand DATABASE_URL est utilisée.
DB_SSL=false
DB_SYNCHRONIZE=true
# Exécute les migrations TypeORM au démarrage (activé par défaut en production).
DB_MIGRATIONS_RUN=false

# Générer un secret aléatoire d’au moins 32 caractères, par exemple avec openssl rand -base64 48.
JWT_SECRET=remplacer-par-un-secret-aleatoire-long-d-au-moins-32-caracteres
JWT_EXPIRES_IN=4h
BCRYPT_ROUNDS=12

# Libellé générique du document interne; ne pas y inscrire de coordonnées non vérifiées.
DOCUMENT_ISSUER=SRE — Service de démonstration

# Rappels d'échéances fiscales (job quotidien 06:00, fuseau métier)
RAPPELS_ACTIFS=true
RAPPELS_JOURS_AVANT=7,3,1,0
RAPPELS_JOURS_RETARD=1,3,7
RAPPELS_TENTATIVES_COURRIEL_MAX=3
FUSEAU_HORAIRE=Indian/Antananarivo
APP_URL=http://localhost:5173

# Courriel des rappels : MAIL_TRANSPORT=smtp (réel) ou capture (tests/dev, aucun envoi)
# Sans MAIL_TRANSPORT, aucun courriel n'est envoyé ni annoncé comme envoyé.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

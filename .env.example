# Copiez en .env et renseignez tous les secrets avant le démarrage.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sre_app
DB_PASSWORD=
DB_DATABASE=sre_demo
DB_SSL=false
DB_SYNCHRONIZE=false

# Générer un secret aléatoire d’au moins 32 caractères, par exemple avec openssl rand -base64 48.
JWT_SECRET=
JWT_EXPIRES_IN=4h
BCRYPT_ROUNDS=12

# Libellé générique du document interne; ne pas y inscrire de coordonnées non vérifiées.
DOCUMENT_ISSUER=SRE · document interne

# Rappels d'échéances fiscales (job quotidien 06:00, fuseau métier)
RAPPELS_ACTIFS=true
RAPPELS_JOURS_AVANT=7,3,1,0
RAPPELS_JOURS_RETARD=1,3,7
RAPPELS_TENTATIVES_COURRIEL_MAX=3
FUSEAU_HORAIRE=Indian/Antananarivo
APP_URL=http://localhost:5173

# Courriel des rappels : MAIL_TRANSPORT=smtp (réel) ou capture (tests/dev, aucun envoi)
# Sans MAIL_TRANSPORT, aucun courriel n'est envoyé ni annoncé comme envoyé.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
